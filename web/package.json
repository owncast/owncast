{
  "name": "owncast-web",
  "version": "0.1.0",
  "private": true,
  "resolutions": {
    "babel-preset-current-node-syntax": "1.1.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node build-scripts/generate-sw.js",
    "antd:extract": "node build-scripts/extract-antd-styles.js",
    "start": "next start",
    "check": "npm run check:lint && npm run check:format && npm run typecheck && npm run check:unused && npm test && npm run build",
    "check:lint": "jsfiles=$(git diff --name-only origin/develop... | grep '^web/.*\\.[jt]sx\\?$' | sed 's|^web/||'); cssfiles=$(git diff --name-only origin/develop... | grep '^web/.*\\.s\\?css$' | grep -vE '^web/(public/styles/plugin.css|styles/variables.css)$' | sed 's|^web/||'); ([ -z \"$jsfiles\" ] || echo \"$jsfiles\" | xargs eslint) && ([ -z \"$cssfiles\" ] || echo \"$cssfiles\" | xargs stylelint)",
    "check:format": "files=$(git diff --name-only origin/develop... | grep '^web/.*\\.\\(js\\|ts\\|jsx\\|tsx\\|css\\|scss\\)$' | sed 's|^web/||'); [ -z \"$files\" ] || echo \"$files\" | xargs prettier --check",
    "check:unused": "knip --include dependencies,files,exports",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix --ext .js,.ts,.tsx types/ pages/ components/ && npm run stylelint",
    "lint:changed": "files=$(git diff --name-only origin/develop... | grep '^web/.*\\.[jt]sx\\?$' | sed 's|^web/||'); [ -z \"$files\" ] || echo \"$files\" | xargs eslint --fix",
    "stylelint": "stylelint --fix **/*.scss",
    "stylelint:changed": "files=$(git diff --name-only origin/develop... | grep '^web/.*\\.s\\?css$' | grep -vE '^web/(public/styles/plugin.css|styles/variables.css)$' | sed 's|^web/||'); [ -z \"$files\" ] || echo \"$files\" | xargs stylelint --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-styles": "cd ./style-definitions && style-dictionary build && ./build.sh && cd - && npm run antd:extract",
    "test": "jest",
    "licenses": "node ../build/generate-licenses.mjs",
    "format": "prettier --write **/*.{js,ts,jsx,tsx,css,md,scss}",
    "format:changed": "files=$(git diff --name-only origin/develop... | grep '^web/' | sed 's|^web/||'); [ -z \"$files\" ] || echo \"$files\" | xargs prettier --write",
    "translate": "node scripts/i18n-extract.js"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.1",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "^6.4.2",
    "@codemirror/lang-javascript": "^6.1.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language-data": "6.5.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/poppins": "5.2.7",
    "@next/bundle-analyzer": "^16.2.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@uiw/codemirror-theme-bbedit": "4.25.10",
    "@uiw/react-codemirror": "4.25.10",
    "@xstate/react": "^6.1.0",
    "antd": "6.5.0",
    "autoprefixer": "^10.4.14",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "bowser": "2.14.1",
    "chart.js": "^4.2.0",
    "classnames": "2.5.1",
    "date-fns": "^4.0.0",
    "emoji-mart": "^5.2.2",
    "glob": "^13.0.0",
    "graphemer": "^1.4.0",
    "i18next-scanner": "^4.6.0",
    "interweave": "^13.0.0",
    "interweave-autolink": "^5.1.0",
    "jotai": "^2.20.1",
    "lodash": "4.18.1",
    "next": "^16.2.10",
    "next-export-i18n": "2.3.5",
    "postcss-flexbugs-fixes": "5.0.2",
    "react": "18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-hotkeys-hook": "5.3.3",
    "react-linkify": "1.0.0-alpha",
    "react-markdown": "10.1.0",
    "react-virtuoso": "4.18.10",
    "sanitize-html": "^2.11.0",
    "semver": "^7.6.3",
    "sharp": "0.34.5",
    "video.js": "^8.3.0",
    "xstate": "^5.32.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "^7.25.7",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@mdx-js/react": "3.1.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/nextjs": "^10.4.6",
    "@svgr/webpack": "8.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.10.7",
    "@types/prop-types": "15.7.15",
    "@types/react": "18.3.31",
    "@types/react-linkify": "1.0.4",
    "@types/sanitize-html": "^2.9.0",
    "@types/video.js": "^7.3.50",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "babel-loader": "10.1.1",
    "chromatic": "17.8.0",
    "css-loader": "7.1.4",
    "cypress": "^15.0.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-next": "^15.5.20",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-storybook": "10.5.0",
    "handlebars": "^4.7.9",
    "html-webpack-plugin": "5.6.7",
    "install": "^0.13.0",
    "jest-environment-jsdom": "^30.0.4",
    "knip": "^6.0.0",
    "mdx-mermaid": "^2.0.0",
    "mermaid": "^11.10.0",
    "msw": "^2.11.6",
    "msw-storybook-addon": "^2.0.6",
    "npm": "^11.0.0",
    "postcss": "^8.4.31",
    "prettier": "3.9.6",
    "puppeteer-core": "^22.15.0",
    "sass": "1.100.0",
    "storybook": "^10.4.6",
    "style-dictionary": "5.5.0",
    "style-loader": "4.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^6.0.0",
    "workbox-build": "^7.4.1"
  },
  "overrides": {
    "@emoji-mart/react": {
      "emoji-mart": "5.6.0"
    }
  },
  "msw": {
    "workerDirectory": [
      "public/"
    ]
  }
}
